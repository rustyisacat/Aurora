<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Android 11+ package-visibility: without this, AuroraNotificationListenerService
         can see a StatusBarNotification's title/text just fine (that data comes bundled
         in the notification itself) but PackageManager.getApplicationLabel/getApplicationInfo
         for that same package throws NameNotFoundException, silently degrading the
         Notifications card to raw package names ("com.instagram.lite") instead of the
         app's real display name - notification access does not imply package visibility,
         these are two separate Android restrictions. The MAIN/LAUNCHER intent query covers
         every regular user-facing app (anything with a home-screen icon), which is
         effectively "any app that could plausibly post a notification" here. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
    </queries>

    <!-- Required for NanoHTTPD to open a listening server socket, not just for outbound requests. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Lets WeatherRepository check connectivity before attempting a fetch, instead of
         eating a guaranteed-to-fail request/timeout every 15 minutes while offline. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Dangerous permission - requested at runtime by MainActivity. Denial is handled
         gracefully: CalendarRepository just reports an empty event list. -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />

    <!-- Dangerous permission - requested at runtime by MainActivity. Coarse is
         plenty precise for weather; denial is handled gracefully by falling
         back to WeatherConfig's fixed coordinate, same as before this existed. -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- AuroraNsdAdvertiser: advertises the HTTP server via mDNS/NSD
         (_aurora._tcp) so the dashboard can find it without a hardcoded IP.
         CHANGE_WIFI_MULTICAST_STATE backs the MulticastLock it holds while
         registered - without it, Wi-Fi power-save can silently drop the
         inbound multicast packets mDNS depends on. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!-- AuroraBackgroundService keeps the HTTP server alive independent of
         MainActivity, and needs to know whether the phone is on the home
         Wi-Fi network (HomeNetworkMonitor) to decide whether to run it. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />

    <!-- Dangerous on API 33+ (auto-granted below that) - requested at runtime by
         MainActivity. Needed to show AuroraBackgroundService's persistent
         notification; without it Android silently drops the notification but
         the foreground service (and the server) still runs. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- AlarmManager alarms don't survive a reboot on their own -
         WakeAlarmBootReceiver re-arms every enabled wake alarm on restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- "Notification policy access" - not a runtime dialog, granted via a
         Settings deep link (same shape as notification listener access
         above). Needed for the dashboard's Do Not Disturb toggle to
         actually change the phone's interruption filter. -->
    <uses-permission android:name="android.permission.ACCESS_NOTIFICATION_POLICY" />

    <application
        android:name=".AuroraApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.Aurora"
        android:supportsRtl="true">

        <activity
            android:name=".ui.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.Aurora">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Android instantiates this itself once notification access is granted
             in system Settings; it is not started by app code. -->
        <service
            android:name=".notifications.AuroraNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Started once from MainActivity (see its doc comment for why not
             from AuroraApplication.onCreate) and kept alive with
             START_STICKY from then on - this is what lets the HTTP server
             survive the app being closed. connectedDevice looked like the
             right fit at first (Aurora exists to interact with the Echo
             Show), but the platform enforces it strictly: it requires
             holding a Bluetooth/USB/NFC/IR/UWB or Wi-Fi-state-change
             permission as proof of an actual paired-device connection,
             none of which Aurora has any real use for since it talks to
             the Echo Show over plain HTTP, not a paired protocol. specialUse
             is the type actually meant for exactly this "doesn't fit the
             others" case. -->
        <service
            android:name=".service.AuroraBackgroundService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Serves the bedside dashboard's data to the Echo Show over the home Wi-Fi network" />
        </service>

        <!-- Fired by AlarmManager at each wake alarm's scheduled time. -->
        <receiver
            android:name=".wakealarm.WakeAlarmReceiver"
            android:exported="false" />

        <!-- Re-arms every enabled wake alarm after a reboot - see the
             RECEIVE_BOOT_COMPLETED permission above. -->
        <receiver
            android:name=".wakealarm.WakeAlarmBootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

    </application>

</manifest>
